<?php

/**
 * @file
 * Allows editors to add content to an entityqueue from the same add/edit form.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\entityqueue_form_widget\Hook\EntityqueueFormWidgetHooks;

/**
 * Implements hook_form_node_form_alter().
 */
#[LegacyHook]
function entityqueue_form_widget_form_node_form_alter(&$form, FormStateInterface $form_state) {
  \Drupal::service(EntityqueueFormWidgetHooks::class)->formNodeFormAlter($form, $form_state);
}

/**
 * Submit form function.
 *
 * Legacy wrapper kept for cached forms and external callers; the logic lives
 * in the EntityqueueFormWidgetHooks service.
 *
 * @param array $form
 *   The Form.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The Form state.
 */
function entityqueue_form_widget_form_node_form_submit(array $form, FormStateInterface $form_state) {
  \Drupal::service(EntityqueueFormWidgetHooks::class)->doNodeFormSubmit($form, $form_state);
}

/**
 * Get allowed sub queue for entityqueues list.
 *
 * Legacy wrapper; the logic lives in the EntityqueueFormWidgetHooks service.
 *
 * @param object $node
 *   A node.
 *
 * @return array
 *   List of allowed sub-queue.
 */
function entity_qget_allowed_subque_list($node) {
  return \Drupal::service(EntityqueueFormWidgetHooks::class)->getAllowedSubqueueList($node);
}

/**
 * Prepare a checkbox for allowed entityqueue.
 *
 * Legacy wrapper; the logic lives in the EntityqueueFormWidgetHooks service.
 *
 * @param int $entity_id
 *   Entity ID.
 * @param array $allowed_entityqueue
 *   The allowed entityqueue info (id, act_as_queue_status).
 *
 * @return array
 *   Values needed to render a checkbox.
 */
function _prepare_checkbox($entity_id, array $allowed_entityqueue) {
  return \Drupal::service(EntityqueueFormWidgetHooks::class)->prepareCheckbox($entity_id, $allowed_entityqueue);
}
